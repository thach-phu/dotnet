@model MVC.Models.ProductEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm sản phẩm mới - Quản trị" : $"Sửa: {Model.Name} - Quản trị";
    var categories = (IReadOnlyList<MVC.Models.Category>)ViewBag.Categories ?? [];
}

<div class="breadcrumb-nav mb-4">
    <a asp-controller="Admin" asp-action="Index">Quản trị</a>
    <span class="sep">/</span>
    <span class="current">@(Model.Id == 0 ? "Thêm sản phẩm" : "Chỉnh sửa sản phẩm")</span>
</div>

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm bg-white p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <span class="text-primary small fw-bold text-uppercase">HỆ THỐNG SẢN PHẨM</span>
                    <h2 class="fs-4 fw-bold mt-1 mb-0">@(Model.Id == 0 ? "Thêm sản phẩm iPhone mới" : "Chỉnh sửa thông tin sản phẩm")</h2>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-1 small">
                    ✕ Đóng
                </a>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="alert alert-danger rounded-3 py-2 px-3 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <form asp-action="SaveProduct" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold text-secondary">Tên sản phẩm iPhone <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control rounded-3" placeholder="Ví dụ: iPhone 16 Pro Max 256GB" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary">Dòng danh mục <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="form-select rounded-3">
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Name" selected="@(Model.Category == cat.Name)">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label small fw-semibold text-secondary">Giá niêm yết (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Price" type="number" step="10000" class="form-control rounded-3 border-end-0" placeholder="30990000" required />
                            <span class="input-group-text bg-light border-start-0">₫</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Stock" class="form-label small fw-semibold text-secondary">Tồn kho</label>
                        <input asp-for="Stock" type="number" min="0" class="form-control rounded-3" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Emoji" class="form-label small fw-semibold text-secondary">Icon / Emoji</label>
                        <input asp-for="Emoji" class="form-control rounded-3" placeholder="📱" />
                        <span asp-validation-for="Emoji" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label small fw-semibold text-secondary">Đường dẫn hình ảnh (URL)</label>
                        <input asp-for="ImageUrl" id="imgUrlInput" class="form-control rounded-3" placeholder="https://example.com/iphone.jpg" oninput="document.getElementById('previewImg').src = this.value;" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Image Preview Area -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <span class="small text-muted d-block mb-2">Xem trước hình ảnh thiết bị:</span>
                            <img id="previewImg" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "https://placehold.co/300x300?text=Preview" : Model.ImageUrl)" alt="Preview" class="rounded-3 object-fit-contain" style="max-height: 160px; max-width: 100%;" onerror="this.src='https://placehold.co/300x300?text=Kh%C3%B4ng+t%E1%BA%A3i+%C4%91%C6%B0%E1%BB%A3c+%E1%BA%A3nh';" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-semibold text-secondary">Mô tả thông số &amp; tính năng</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Chip A18 Pro, màn hình Super Retina XDR 120Hz, camera 48MP, thiết kế Titanium..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch p-3 bg-light rounded-3 border">
                            <input asp-for="IsPopular" class="form-check-input ms-0 me-3" type="checkbox" id="popularSwitch" />
                            <label class="form-check-label fw-bold text-dark" for="popularSwitch">
                                🔥 Đặt làm sản phẩm Nổi Bật (Hot) trên Trang Chủ
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn-apple-primary px-4 py-2">
                        <span>Lưu sản phẩm</span>
                        <span class="arrow-icon">→</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>