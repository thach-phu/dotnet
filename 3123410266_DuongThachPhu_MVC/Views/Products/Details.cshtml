@model MVC.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} - Phú Store";
}

<!-- Breadcrumb -->
<div class="breadcrumb-nav">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <span class="sep">/</span>
    <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
    <span class="sep">/</span>
    <span class="current">@Model.Name</span>
</div>

<!-- Main Detail Grid -->
<div class="product-detail-layout">
    <!-- Left: Image Gallery & Commitments -->
    <div class="detail-gallery-col">
        <div class="detail-main-image-wrap">
            <span class="badge-vna-large">VN/A CHÍNH HÃNG</span>
            @if (Model.IsPopular)
            {
                <span class="badge-hot-large">🔥 BÁN CHẠY</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="detail-main-img" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
            }
            <span class="img-emoji-fallback detail-fallback" style="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "display:block" : null)">@Model.Emoji</span>
        </div>
        <div class="detail-commitments">
            <div class="commit-item">
                <span>🛡️</span>
                <span>Bảo hành chính hãng 12 tháng tại Apple Authorised Care</span>
            </div>
            <div class="commit-item">
                <span>🔄</span>
                <span>1 đổi 1 trong 30 ngày nếu phát sinh lỗi từ nhà sản xuất</span>
            </div>
            <div class="commit-item">
                <span>📦</span>
                <span>Bộ sản phẩm gồm: Thân máy nguyên seal, Cáp sạc USB-C, Sách hướng dẫn</span>
            </div>
        </div>
    </div>

    <!-- Right: Purchase Options & Specs Summary -->
    <div class="detail-info-col">
        <div class="detail-category-tag"> @Model.Category.ToUpperInvariant()</div>
        <h1 class="detail-title">@Model.Name</h1>

        <div class="detail-rating-row">
            <span class="rating-stars">★★★★★</span>
            <span class="rating-score">4.9/5</span>
            <span class="rating-count">(158 đánh giá thực tế)</span>
            <span class="stock-badge in-stock">● Còn hàng tại showroom</span>
        </div>

        <div class="detail-price-box">
            <div class="price-box-main">
                <span class="price-prefix">Giá chính hãng VN/A:</span>
                <strong class="detail-price-val">@Model.Price.ToString("N0")₫</strong>
            </div>
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2">
                <span class="price-tax-badge">Đã bao gồm VAT &amp; Miễn phí vận chuyển</span>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 small fw-bold">
                    💳 Trả góp 0% chỉ từ ~@((Model.Price / 6).ToString("N0"))₫/tháng
                </span>
            </div>
        </div>

        <!-- Promotions Box -->
        <div class="promo-perks-box my-3">
            <div class="promo-box-title">🎁 ƯU ĐÃI ĐỘC QUYỀN TẠI PHÚ STORE</div>
            <ul class="promo-perks-list">
                <li>✓ <b>Tặng củ sạc nhanh Apple 20W Type-C</b> chính hãng khi mua máy.</li>
                <li>✓ <b>Giảm thêm 500.000₫</b> khi thanh toán chuyển khoản qua ngân hàng.</li>
                <li>✓ <b>Tặng gói dán màn hình cường lực KingKong</b> cao cấp miễn phí.</li>
                <li>✓ Hỗ trợ <b>trả góp 0%</b> qua thẻ tín dụng và CCCD gắn chip.</li>
            </ul>
        </div>

        <div class="detail-description-block">
            <h3>Đặc điểm nổi bật</h3>
            <p>@Model.Description</p>
        </div>

        <!-- Add to cart form -->
        <form asp-controller="Products" asp-action="AddToCart" method="post" class="detail-actions-area">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

            <div class="quantity-selector-wrap">
                <span class="qty-label">Số lượng:</span>
                <div class="qty-controls">
                    <button type="button" class="btn-qty" onclick="var q = document.getElementById('qtyInput'); if(q.value > 1) q.value--;">-</button>
                    <input type="number" id="qtyInput" name="quantity" value="1" min="1" max="20" class="input-qty" />
                    <button type="button" class="btn-qty" onclick="var q = document.getElementById('qtyInput'); if(q.value < 20) q.value++;">+</button>
                </div>
            </div>

            <div class="detail-btn-row">
                <button type="submit" class="btn-buy-now">
                    <span class="btn-icon">🛒</span>
                    <span class="btn-text-wrap">
                        <strong>Thêm vào giỏ hàng</strong>
                        <small>Giao hàng tận nơi miễn phí toàn quốc</small>
                    </span>
                </button>
            </div>
        </form>

        <!-- Technical Specifications Table -->
        <div class="detail-specs-box mt-4">
            <h4 class="specs-title">Thông số kỹ thuật tiêu chuẩn</h4>
            <table class="detail-specs-table">
                <tbody>
                    <tr>
                        <th>Dòng máy</th>
                        <td>@Model.Category chính hãng Apple VN/A</td>
                    </tr>
                    <tr>
                        <th>Tình trạng</th>
                        <td>Mới 100% nguyên seal chưa kích hoạt</td>
                    </tr>
                    <tr>
                        <th>Bảo hành</th>
                        <td>12 tháng tại các trung tâm Apple ủy quyền (AASP)</td>
                    </tr>
                    <tr>
                        <th>Đổi mới</th>
                        <td>30 ngày lỗi 1 đổi 1 tận nhà</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="detail-back-link-row mt-4">
            <a asp-controller="Products" asp-action="Index" class="back-link">
                ← Quay lại danh sách sản phẩm
            </a>
        </div>
    </div>
</div>
