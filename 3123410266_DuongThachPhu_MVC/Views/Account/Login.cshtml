@model MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập tài khoản - Phú Store";
}

<div class="login-page-container py-5">
    <div class="login-box-card mx-auto p-4 p-md-5 bg-white border rounded-4 shadow-sm" style="max-width: 480px;">
        <div class="login-header-section text-center mb-4">
            <div class="login-brand-logo mb-2">
                <span class="apple-symbol fs-1"></span>
            </div>
            <span class="text-primary small fw-bold text-uppercase letter-spacing-1">HỆ THỐNG PHÚ STORE</span>
            <h1 class="login-main-title fs-3 fw-bold mt-1 mb-2">Đăng Nhập</h1>
            <p class="login-subtext text-muted small">
                Đăng nhập tài khoản để theo dõi đơn hàng và tận hưởng ưu đãi dành riêng cho thành viên.
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
        {
            <div class="alert alert-danger rounded-3 py-2 px-3 small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                @Html.ValidationSummary(true, "")
            </div>
        }

        <form method="post" asp-action="Login">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary">Địa chỉ Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" id="emailInput" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="passwordInput" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu..." required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-apple-primary w-100 py-3 text-center justify-content-center fs-6 fw-bold">
                <span>Đăng nhập</span>
                <span class="ms-1">→</span>
            </button>
        </form>

        <div class="login-footer-text text-center mt-4 text-muted small">
            Chưa có tài khoản? <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Đăng ký tài khoản mới</a>
        </div>
    </div>
</div>
