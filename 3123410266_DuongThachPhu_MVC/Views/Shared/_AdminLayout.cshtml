@using MVC.Models
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phú Store Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
</head>
<body class="admin-body">
    <div class="admin-app-shell">
        <header class="admin-topbar">
            <a class="admin-topbar-brand" asp-controller="Admin" asp-action="Index">
                <span class="brand-apple-icon"></span>
                <span>Phú Store <strong>Admin</strong></span>
            </a>
            <div class="admin-topbar-actions d-flex align-items-center gap-3">
                <a asp-controller="Home" asp-action="Index" target="_blank" class="admin-topbar-storefront text-white-50 text-decoration-none small d-flex align-items-center gap-1 hover-light">
                    <i class="bi bi-shop"></i>
                    <span>Xem Cửa Hàng</span>
                </a>
                <span class="admin-topbar-user d-flex align-items-center gap-1">
                    <i class="bi bi-person-circle"></i>
                    <span>@(User.Identity?.Name)</span>
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-topbar-logout d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </header>

        <main class="admin-main-content admin-main-content-flush">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>