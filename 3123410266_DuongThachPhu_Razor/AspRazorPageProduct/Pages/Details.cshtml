@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Chi tiết sản phẩm";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-page="/Index" asp-route-Category="@Model.Product?.Category" class="text-decoration-none text-muted">@Model.Product?.Category</a></li>
        <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@Model.Product?.Name</li>
    </ol>
</nav>

@if (Model.Product == null)
{
    <div class="card border-0 rounded-4 shadow-sm text-center py-5 bg-white">
        <div class="card-body">
            <div class="display-1 text-muted mb-3"><i class="bi bi-exclamation-circle"></i></div>
            <h3 class="fw-bold">Sản phẩm không tồn tại</h3>
            <p class="text-muted mb-4">Sản phẩm này có thể đã ngừng kinh doanh hoặc đường dẫn không hợp lệ.</p>
            <a asp-page="/Index" class="ts-btn-primary px-4 py-2">
                <span>Quay lại cửa hàng</span>
            </a>
        </div>
    </div>
}
else
{
    <div class="ts-detail-card">
        <div class="row g-0">
            <!-- Left: Product Media & Guarantees -->
            <div class="col-lg-6">
                <div class="ts-detail-img-box">
                    <img src="@Model.Product.ImageUrl" class="ts-detail-img" alt="@Model.Product.Name" onerror="this.src='https://placehold.co/500x500?text=TechStore';" />
                </div>
                
                <div class="p-4 bg-light border-top">
                    <div class="row g-3">
                        <div class="col-sm-4 text-center">
                            <i class="bi bi-shield-check text-success fs-3 d-block mb-1"></i>
                            <span class="small fw-bold d-block">Bảo hành 12T</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Chính hãng toàn quốc</small>
                        </div>
                        <div class="col-sm-4 text-center">
                            <i class="bi bi-arrow-repeat text-primary fs-3 d-block mb-1"></i>
                            <span class="small fw-bold d-block">1 Đổi 1 Trong 30N</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Lỗi là đổi mới</small>
                        </div>
                        <div class="col-sm-4 text-center">
                            <i class="bi bi-truck text-warning fs-3 d-block mb-1"></i>
                            <span class="small fw-bold d-block">Giao siêu tốc 2h</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Miễn phí nội thành</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Details & Purchase -->
            <div class="col-lg-6 ts-detail-info">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark rounded-pill px-3 py-1 font-monospace text-uppercase">
                            @Model.Product.Category
                        </span>
                        @if (Model.Product.Stock > 0)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-bold">
                                <i class="bi bi-check-circle me-1"></i>Còn hàng (@Model.Product.Stock)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 fw-bold">
                                <i class="bi bi-x-circle me-1"></i>Tạm hết hàng
                            </span>
                        }
                    </div>

                    <h1 class="fs-2 fw-bold text-dark mb-2">@Model.Product.Name</h1>
                    
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="text-warning small">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <span class="small fw-bold text-dark">4.9 / 5</span>
                        <span class="text-muted small">(128 đánh giá thực tế)</span>
                    </div>

                    <div class="p-3 bg-light rounded-4 border mb-4">
                        <span class="text-muted small d-block mb-1">Giá bán chính hãng:</span>
                        <div class="d-flex align-items-baseline gap-3">
                            <span class="ts-detail-price">@Model.Product.Price.ToString("N0")₫</span>
                            <span class="text-muted text-decoration-line-through">@((Model.Product.Price * 1.15m).ToString("N0"))₫</span>
                            <span class="badge bg-danger rounded-pill">-15%</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top mt-2">
                            <small class="text-success fw-semibold"><i class="bi bi-check2-all me-1"></i>Đã bao gồm VAT &amp; Miễn phí vận chuyển toàn quốc</small>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 small">
                                💳 Trả góp 0% chỉ từ ~@((Model.Product.Price / 6).ToString("N0"))₫/tháng
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2">Đặc điểm &amp; Tính năng nổi bật:</h6>
                        <p class="text-secondary mb-3" style="line-height: 1.7;">
                            @Model.Product.Description
                        </p>

                        <!-- TechStore Exclusive Perks Box -->
                        <div class="p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 mb-4">
                            <h6 class="fw-bold text-primary small text-uppercase mb-2">
                                <i class="bi bi-gift-fill me-1"></i> Ưu Đãi Độc Quyền Tại TechStore
                            </h6>
                            <ul class="list-unstyled mb-0 small text-secondary d-flex flex-column gap-1">
                                <li>✓ <b>Tặng củ sạc nhanh Type-C</b> công suất cao chính hãng theo máy.</li>
                                <li>✓ <b>Giảm thêm 500.000₫</b> khi thanh toán qua cổng quét mã VietQR.</li>
                                <li>✓ <b>Tặng gói dán màn hình cao cấp</b> miễn phí bảo hành 12 tháng.</li>
                                <li>✓ Hỗ trợ <b>thu cũ đổi mới</b> trợ giá lên đến 3.000.000₫.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Purchase Form -->
                <form method="post" asp-page-handler="AddToCart" asp-route-id="@Model.Product.Id" class="pt-3 border-top">
                    <div class="row g-3 align-items-center mb-3">
                        <div class="col-auto">
                            <label class="form-label small fw-bold mb-0 text-secondary">Số lượng mua:</label>
                        </div>
                        <div class="col-auto">
                            <div class="input-group" style="width: 120px;">
                                <button type="button" class="btn btn-outline-secondary" onclick="var q=document.getElementById('buyQty'); if(q.value>1) q.value--;">-</button>
                                <input type="number" id="buyQty" asp-for="Quantity" class="form-control text-center shadow-none border-secondary" min="1" max="@Model.Product.Stock" />
                                <button type="button" class="btn btn-outline-secondary" onclick="var q=document.getElementById('buyQty'); if(q.value<@Model.Product.Stock) q.value++;">+</button>
                            </div>
                        </div>
                        <div class="col">
                            <button type="submit" class="ts-btn-primary w-100 py-3 fs-6" @(Model.Product.Stock <= 0 ? "disabled" : "")>
                                <i class="bi bi-cart-plus-fill me-2 fs-5"></i>
                                <span>Thêm Vào Giỏ Hàng</span>
                            </button>
                        </div>
                    </div>
                </form>

                <div class="text-start mt-2">
                    <a asp-page="/Index" class="small text-muted text-decoration-none">
                        ← Tiếp tục xem danh mục sản phẩm khác
                    </a>
                </div>
            </div>
        </div>
    </div>
}
