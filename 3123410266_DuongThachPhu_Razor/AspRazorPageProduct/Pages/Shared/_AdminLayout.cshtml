@using AspRazorPageProduct.Models
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AspRazorPageProduct.styles.css" asp-append-version="true" />
</head>
<body class="admin-body">
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    }
    <div class="admin-app-shell">
        <header class="admin-topbar">
            <a class="admin-topbar-brand" asp-page="/Admin/Dashboard/Index">
                <i class="bi bi-cpu-fill"></i>
                <span>TechStore <strong>Admin</strong></span>
            </a>
            <div class="admin-topbar-actions d-flex align-items-center gap-3">
                <a href="/" target="_blank" class="admin-topbar-storefront text-white-50 text-decoration-none small d-flex align-items-center gap-1 hover-light">
                    <i class="bi bi-shop"></i>
                    <span>Xem Cửa Hàng</span>
                </a>
                <span class="admin-topbar-user d-flex align-items-center gap-1">
                    <i class="bi bi-person-circle"></i>
                    <span>@User.Identity?.Name</span>
                </span>
                <form method="post" asp-page="/Account/Logout" class="d-inline m-0">
                    <button type="submit" class="admin-topbar-logout d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </header>

        <div class="admin-dashboard-layout">
            <nav class="admin-sidebar">
                <a class="admin-sidebar-link @(currentPage.Contains("/Admin/Dashboard") ? "active" : "")" asp-page="/Admin/Dashboard/Index">
                    <span class="sidebar-icon"><i class="bi bi-speedometer2"></i></span>
                    <span>Dashboard</span>
                </a>
                @if (User.HasClaim(Permissions.ClaimType, Permissions.ProductsManage))
                {
                    <a class="admin-sidebar-link @(currentPage.Contains("/Admin/Products") ? "active" : "")" asp-page="/Admin/Products/Index">
                        <span class="sidebar-icon"><i class="bi bi-phone-fill"></i></span>
                        <span>Quản Lý Sản Phẩm</span>
                    </a>
                }
                @if (User.HasClaim(Permissions.ClaimType, Permissions.CategoriesManage))
                {
                    <a class="admin-sidebar-link @(currentPage.Contains("/Admin/Categories") ? "active" : "")" asp-page="/Admin/Categories/Index">
                        <span class="sidebar-icon"><i class="bi bi-tags-fill"></i></span>
                        <span>Danh Mục</span>
                    </a>
                }
                @if (User.HasClaim(Permissions.ClaimType, Permissions.OrdersManage))
                {
                    <a class="admin-sidebar-link @(currentPage.Contains("/Admin/Orders") ? "active" : "")" asp-page="/Admin/Orders/Index">
                        <span class="sidebar-icon"><i class="bi bi-receipt"></i></span>
                        <span>Quản Lý Đơn Hàng</span>
                    </a>
                }
                @if (User.HasClaim(Permissions.ClaimType, Permissions.UsersManage))
                {
                    <a class="admin-sidebar-link @(currentPage.Contains("/Admin/Users") ? "active" : "")" asp-page="/Admin/Users/Index">
                        <span class="sidebar-icon"><i class="bi bi-people-fill"></i></span>
                        <span>Người Dùng &amp; Phân Quyền</span>
                    </a>
                }
                @if (User.HasClaim(Permissions.ClaimType, Permissions.CustomersManage))
                {
                    <a class="admin-sidebar-link @(currentPage.Contains("/Admin/Customers") ? "active" : "")" asp-page="/Admin/Customers/Index">
                        <span class="sidebar-icon"><i class="bi bi-person-heart"></i></span>
                        <span>Khách Hàng</span>
                    </a>
                }
            </nav>

            <main class="admin-content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>