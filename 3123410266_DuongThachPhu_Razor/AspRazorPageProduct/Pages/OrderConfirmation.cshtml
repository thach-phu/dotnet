@page "{id}"
@model OrderConfirmationModel
@{
    ViewData["Title"] = "Đặt Hàng Thành Công - TechStore";
}

@if (Model.Order == null)
{
    <div class="card border-0 rounded-4 shadow-sm text-center py-5 bg-white">
        <div class="card-body">
            <div class="display-1 text-danger mb-3"><i class="bi bi-x-circle"></i></div>
            <h3 class="fw-bold">Không tìm thấy đơn hàng</h3>
            <p class="text-muted mb-4">Đơn hàng không tồn tại hoặc đã bị xóa khỏi hệ thống.</p>
            <a asp-page="/Index" class="ts-btn-primary px-4 py-2">
                <span>Quay lại trang chủ</span>
            </a>
        </div>
    </div>
}
else
{
    <div class="row justify-content-center my-4">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white text-center">
                <div class="mb-3">
                    <div class="d-inline-grid place-items-center bg-success-subtle text-success rounded-circle" style="width: 80px; height: 80px; font-size: 2.5rem;">
                        <i class="bi bi-check-lg"></i>
                    </div>
                </div>
                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill small fw-bold mb-2">ĐẶT HÀNG THÀNH CÔNG!</span>
                <h2 class="fw-bold text-dark mb-2">Cảm ơn bạn đã mua hàng tại TechStore</h2>
                <p class="text-muted small mb-4">
                    Đơn hàng của bạn đã được ghi nhận. Chúng tôi sẽ chuẩn bị hàng và liên hệ xác nhận trong thời gian sớm nhất.
                </p>

                <!-- Digital Invoice Card -->
                <div class="p-4 bg-light rounded-4 border text-start mb-4">
                    <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3 flex-wrap gap-2">
                        <div>
                            <span class="text-muted small d-block">MÃ ĐƠN HÀNG</span>
                            <strong class="fs-4 text-primary font-monospace">#@Model.Order.OrderId</strong>
                        </div>
                        <div class="text-md-end">
                            <span class="text-muted small d-block">NGÀY ĐẶT</span>
                            <span class="fw-medium">@Model.Order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="row g-3 py-2 border-bottom mb-3 small">
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Người nhận:</span>
                            <strong class="text-dark">@Model.Order.CustomerName (@Model.Order.CustomerPhone)</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted d-block">Phương thức thanh toán:</span>
                            <span class="badge bg-light text-dark border">@Model.Order.PaymentMethod</span>
                        </div>
                        <div class="col-12">
                            <span class="text-muted d-block">Địa chỉ nhận hàng:</span>
                            <span class="text-dark">@Model.Order.ShippingAddress</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Order.Notes))
                        {
                            <div class="col-12">
                                <span class="text-muted d-block">Ghi chú:</span>
                                <span class="fst-italic text-secondary">@Model.Order.Notes</span>
                            </div>
                        }
                    </div>

                    <!-- Items list -->
                    <h6 class="fw-bold small mb-3">Sản phẩm trong đơn:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Order.Items)
                                {
                                    <tr class="small">
                                        <td class="fw-semibold">@item.Product.Name</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end text-muted">@item.Product.Price.ToString("N0")₫</td>
                                        <td class="text-end fw-bold">@item.TotalPrice.ToString("N0")₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end text-muted small pt-2">Phí vận chuyển:</td>
                                    <td class="text-end text-success fw-bold small pt-2">Miễn phí</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end fs-6 fw-bold">Tổng thanh toán:</td>
                                    <td class="text-end fs-5 fw-bold text-danger">@Model.Order.TotalAmount.ToString("N0")₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="mt-3 text-start">
                        <span class="text-muted small d-block mb-2">Trạng thái đơn hàng:</span>
                        <partial name="/Pages/Shared/_OrderStatusPipeline.cshtml" model="Model.Order.Status" />
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-page="/Index" class="ts-btn-primary px-4 py-2">
                        <span>Tiếp tục mua hàng</span>
                    </a>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" onclick="window.print();">
                        <i class="bi bi-printer me-1"></i> In hóa đơn
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/OrderHistory" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                            Lịch sử đơn hàng
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}
