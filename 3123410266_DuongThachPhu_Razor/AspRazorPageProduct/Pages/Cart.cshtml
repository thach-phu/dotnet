@page
@model CartModel
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn - TechStore";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
        <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Giỏ hàng của bạn</li>
    </ol>
</nav>

@if (!Model.CartItems.Any())
{
    <!-- Empty Cart Screen -->
    <div class="card border-0 rounded-4 shadow-sm text-center py-5 bg-white">
        <div class="card-body">
            <div class="display-1 text-muted mb-3"><i class="bi bi-cart-x"></i></div>
            <h3 class="fw-bold">Giỏ hàng của bạn đang trống!</h3>
            <p class="text-muted mb-4">Hãy khám phá các mẫu laptop, điện thoại và phụ kiện công nghệ để thêm vào giỏ.</p>
            <a asp-page="/Index" class="ts-btn-primary px-5 py-3 fs-6">
                <i class="bi bi-arrow-left me-1"></i> Khám phá sản phẩm ngay
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        <!-- Left: Cart Items List -->
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fs-5 fw-bold mb-0">Sản phẩm trong giỏ (@Model.CartItems.Sum(x => x.Quantity))</h3>
                <form method="post" asp-page-handler="ClearCart" class="m-0" onsubmit="return confirm('Bạn có chắc muốn làm trống giỏ hàng?');">
                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0">
                        <i class="bi bi-trash3 me-1"></i>Xóa tất cả
                    </button>
                </form>
            </div>

            <div class="cart-items-container">
                <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-4 mb-3">
                    <div class="d-flex align-items-center gap-2 text-success fw-bold small mb-2">
                        <i class="bi bi-truck fs-5"></i>
                        <span>Đơn hàng của bạn đủ điều kiện nhận Miễn Phí Vận Chuyển toàn quốc! ⚡</span>
                    </div>
                    <div class="progress rounded-pill bg-success bg-opacity-25" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: 100%;"></div>
                    </div>
                </div>

                @foreach (var item in Model.CartItems)
                {
                    <div class="ts-cart-item">
                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="rounded-3 object-fit-contain bg-light p-2" style="width: 75px; height: 75px;" onerror="this.src='https://placehold.co/100x100?text=TechStore';" />
                        
                        <div class="flex-grow-1">
                            <span class="badge bg-secondary-subtle text-secondary small text-uppercase mb-1">@item.Product.Category</span>
                            <h5 class="fs-6 fw-bold mb-1">
                                <a asp-page="/Details" asp-route-id="@item.Product.Id" class="text-dark text-decoration-none">
                                    @item.Product.Name
                                </a>
                            </h5>
                            <span class="text-muted small">Đơn giá: @item.Product.Price.ToString("N0")₫</span>

                            <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
                                <!-- Stepper -->
                                <div class="d-flex align-items-center gap-1">
                                    <form method="post" asp-page-handler="UpdateQuantity" class="d-inline m-0">
                                        <input type="hidden" name="productId" value="@item.Product.Id" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 28px; height: 28px; line-height: 1;" title="Giảm">
                                            -
                                        </button>
                                    </form>

                                    <span class="px-2 fw-bold small">@item.Quantity</span>

                                    <form method="post" asp-page-handler="UpdateQuantity" class="d-inline m-0">
                                        <input type="hidden" name="productId" value="@item.Product.Id" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 28px; height: 28px; line-height: 1;" title="Tăng" @(item.Quantity >= item.Product.Stock ? "disabled" : "")>
                                            +
                                        </button>
                                    </form>
                                </div>

                                <!-- Line Total -->
                                <div>
                                    <strong class="fs-6 text-danger">@item.TotalPrice.ToString("N0")₫</strong>
                                </div>

                                <!-- Delete item -->
                                <form method="post" asp-page-handler="RemoveItem" class="m-0">
                                    <input type="hidden" name="productId" value="@item.Product.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ms-2" title="Xóa">
                                        <i class="bi bi-x-circle fs-5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <a asp-page="/Index" class="small text-muted text-decoration-none fw-semibold">
                    ← Tiếp tục chọn thêm sản phẩm khác
                </a>
            </div>
        </div>

        <!-- Right: Summary Card -->
        <div class="col-lg-4">
            <div class="ts-summary-card">
                <h4 class="fs-6 fw-bold mb-3 pb-2 border-bottom">Tóm tắt đơn hàng</h4>

                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Tạm tính:</span>
                    <strong class="text-dark">@Model.GrandTotal.ToString("N0")₫</strong>
                </div>

                <div class="d-flex justify-content-between mb-3 small">
                    <span class="text-muted">Phí giao hàng:</span>
                    <span class="badge bg-success-subtle text-success fw-bold">Miễn phí toàn quốc</span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-3 small">
                    <i class="bi bi-shield-check text-success me-1"></i>
                    <strong>Cam kết TechStore:</strong> Kiểm tra hàng trước khi thanh toán, đổi trả 1-1 trong 30 ngày.
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fs-6 fw-bold">Tổng thanh toán:</span>
                    <strong class="fs-4 text-danger">@Model.GrandTotal.ToString("N0")₫</strong>
                </div>

                <a asp-page="/Checkout" class="ts-btn-primary w-100 py-3 text-center justify-content-center fs-6">
                    <span>Tiến Hành Đặt Hàng</span>
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}
