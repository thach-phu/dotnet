@page
@model AspRazorPageProduct.Pages.Admin.Categories.CreateModel
@{
    ViewData["Title"] = "Thêm Danh Mục Mới - TechStore Admin";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-page="/Admin/Categories/Index" class="text-decoration-none text-muted">Quản trị danh mục</a></li>
        <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Thêm danh mục</li>
    </ol>
</nav>

<div class="row justify-content-center mb-5">
    <div class="col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <span class="badge bg-warning text-dark fw-bold text-uppercase px-3 py-1 mb-1">PHÂN LOẠI</span>
                    <h3 class="fs-4 fw-bold mt-1 mb-0"><i class="bi bi-tag-fill me-2 text-warning"></i>Thêm Danh Mục Mới</h3>
                </div>
                <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-3 py-1 small">
                    ✕ Đóng
                </a>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label small fw-semibold text-secondary">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Category.Name" class="form-control rounded-3" placeholder="Ví dụ: Gaming Gear, Màn hình OLED..." required />
                    <span asp-validation-for="Category.Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Category.Description" class="form-label small fw-semibold text-secondary">Mô tả danh mục</label>
                    <textarea asp-for="Category.Description" class="form-control rounded-3" rows="3" placeholder="Mô tả nhóm thiết bị thuộc danh mục này..."></textarea>
                    <span asp-validation-for="Category.Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="ts-btn-primary px-4 py-2">
                        <i class="bi bi-save me-1"></i>
                        <span>Lưu Danh Mục</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
