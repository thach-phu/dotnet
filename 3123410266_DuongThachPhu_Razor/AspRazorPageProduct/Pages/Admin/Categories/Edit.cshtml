@page "{id:int}"
@model AspRazorPageProduct.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = $"Chỉnh Sửa: {Model.Category.Name} - TechStore Admin";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-page="/Admin/Categories/Index" class="text-decoration-none text-muted">Quản trị danh mục</a></li>
        <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Chỉnh sửa danh mục</li>
    </ol>
</nav>

<div class="row justify-content-center mb-5">
    <div class="col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <span class="badge bg-warning text-dark fw-bold text-uppercase px-3 py-1 mb-1">CẬP NHẬT</span>
                    <h3 class="fs-4 fw-bold mt-1 mb-0"><i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh Sửa Danh Mục</h3>
                </div>
                <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-3 py-1 small">
                    ✕ Đóng
                </a>
            </div>

            <form method="post">
                <input type="hidden" asp-for="Category.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label small fw-semibold text-secondary">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Category.Name" class="form-control rounded-3" required />
                    <span asp-validation-for="Category.Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Category.Description" class="form-label small fw-semibold text-secondary">Mô tả danh mục</label>
                    <textarea asp-for="Category.Description" class="form-control rounded-3" rows="3"></textarea>
                    <span asp-validation-for="Category.Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="ts-btn-primary px-4 py-2">
                        <i class="bi bi-save me-1"></i>
                        <span>Lưu Thay Đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
