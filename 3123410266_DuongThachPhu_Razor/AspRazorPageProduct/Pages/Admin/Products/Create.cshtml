@page
@model AspRazorPageProduct.Pages.Admin.Products.CreateModel
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới - TechStore Admin";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-page="/Admin/Products/Index" class="text-decoration-none text-muted">Quản trị sản phẩm</a></li>
        <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Thêm sản phẩm mới</li>
    </ol>
</nav>

<div class="row justify-content-center mb-5">
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-1 mb-1">KHO SẢN PHẨM</span>
                    <h3 class="fs-4 fw-bold mt-1 mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Thêm Thiết Bị Công Nghệ Mới</h3>
                </div>
                <a asp-page="/Admin/Products/Index" class="btn btn-outline-secondary rounded-pill px-3 py-1 small">
                    ✕ Đóng
                </a>
            </div>

            <form method="post">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Product.Name" class="form-control rounded-3" placeholder="Ví dụ: Laptop Dell XPS 15 9530 i7" required />
                        <span asp-validation-for="Product.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Giá bán niêm yết (VNĐ) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" asp-for="Product.Price" class="form-control rounded-3 border-end-0" placeholder="25000000" required step="1000" />
                            <span class="input-group-text bg-light border-start-0">₫</span>
                        </div>
                        <span asp-validation-for="Product.Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Danh mục sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="Product.Category" class="form-select rounded-3" required>
                            <option value="Laptop">Laptop</option>
                            <option value="Điện thoại">Điện thoại</option>
                            <option value="Phụ kiện">Phụ kiện</option>
                            <option value="Âm thanh">Âm thanh</option>
                            <option value="Đồng hồ">Đồng hồ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Số lượng tồn kho</label>
                        <input type="number" asp-for="Product.Stock" class="form-control rounded-3" value="10" min="0" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-semibold text-secondary">Đường dẫn hình ảnh (URL)</label>
                        <input type="url" asp-for="Product.ImageUrl" id="imgUrlInput" class="form-control rounded-3" placeholder="https://example.com/laptop.jpg" oninput="document.getElementById('previewImg').src = this.value;" />
                    </div>

                    <!-- Live Image Preview Box -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 text-center border">
                            <span class="small text-muted d-block mb-2">Xem trước hình ảnh:</span>
                            <img id="previewImg" src="https://placehold.co/300x300?text=Preview" alt="Xem trước" class="rounded-3 object-fit-contain" style="max-height: 140px; max-width: 100%;" onerror="this.src='https://placehold.co/300x300?text=Kh%C3%B4ng+t%E1%BA%A3i+%C4%91%C6%B0%E1%BB%A3c';" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold text-secondary">Mô tả thông số kỹ thuật &amp; tính năng</label>
                        <textarea asp-for="Product.Description" class="form-control rounded-3" rows="4" placeholder="Cấu hình CPU, RAM, ổ cứng SSD, màn hình và chế độ bảo hành..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-page="/Admin/Products/Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="ts-btn-primary px-4 py-2">
                        <i class="bi bi-save me-1"></i>
                        <span>Lưu Sản Phẩm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
