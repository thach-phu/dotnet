@page
@model AspRazorPageProduct.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm - TechStore Admin";
    var totalProducts = Model.Products.TotalCount;
}

<!-- Admin Header Banner -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 p-4 rounded-4 bg-dark text-white shadow-sm">
    <div>
        <span class="badge bg-warning text-dark text-uppercase px-3 py-1 mb-2 fw-bold">QUẢN TRỊ KHO HÀNG</span>
        <h1 class="fs-3 fw-bold mb-1">Quản Lý Sản Phẩm Công Nghệ</h1>
        <p class="text-white-50 small mb-0">Theo dõi thông tin thiết bị, giá niêm yết và số lượng hàng tồn kho.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-page="/Admin/Products/Create" class="btn btn-warning text-dark fw-bold rounded-pill px-4 py-2 shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Thêm Sản Phẩm Mới
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 rounded-4 shadow-sm mb-4 bg-white p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" asp-for="Search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên sản phẩm, thương hiệu..." />
                <button class="btn btn-outline-secondary px-3" type="submit">Tìm</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <div class="col-auto">
                <a asp-page="/Admin/Products/Index" class="btn btn-link text-danger text-decoration-none small">
                    ✕ Xóa tìm kiếm
                </a>
            </div>
        }
    </form>
</div>

<!-- Products Table Card -->
<div class="card border-0 rounded-4 shadow-sm mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="fw-bold mb-0">Danh sách sản phẩm (@totalProducts)</h5>
    </div>
    <div class="table-responsive">
        <table class="table align-middle table-hover mb-0">
            <thead class="table-light small text-muted text-uppercase">
                <tr>
                    <th scope="col" style="width: 70px;">Mã</th>
                    <th scope="col" style="width: 80px;">Hình ảnh</th>
                    <th scope="col">Tên sản phẩm</th>
                    <th scope="col">Danh mục</th>
                    <th scope="col">Giá niêm yết</th>
                    <th scope="col">Tồn kho</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Chưa có sản phẩm nào phù hợp với tìm kiếm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td class="fw-bold text-secondary font-monospace">#@item.Id</td>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 object-fit-contain bg-light p-1" style="width: 50px; height: 50px;" onerror="this.src='https://placehold.co/100x100?text=TechStore';" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Description</small>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">@item.Category</span></td>
                            <td class="fw-bold text-danger font-monospace">@item.Price.ToString("N0")₫</td>
                            <td>
                                @if (item.Stock > 5)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-bold">Còn @item.Stock</span>
                                }
                                else if (item.Stock > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1 fw-bold">Sắp hết (@item.Stock)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 fw-bold">Hết hàng</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/Admin/Products/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                                <a asp-page="/Admin/Products/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Xóa">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination Bar -->
@if (Model.Products.TotalPages > 1)
{
    <nav aria-label="Admin Page navigation" class="mb-5">
        <ul class="pagination justify-content-center gap-1">
            <li class="page-item @(!Model.Products.HasPreviousPage ? "disabled" : "")">
                <a class="page-link rounded-pill px-3" asp-page="/Admin/Products/Index" asp-route-PageIndex="@(Model.Products.PageIndex - 1)" asp-route-Search="@Model.Search">
                    ← Trước
                </a>
            </li>
            @for (int i = 1; i <= Model.Products.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Products.PageIndex ? "active" : "")">
                    <a class="page-link rounded-circle text-center mx-1" style="width: 40px; height: 40px; line-height: 24px;" asp-page="/Admin/Products/Index" asp-route-PageIndex="@i" asp-route-Search="@Model.Search">
                        @i
                    </a>
                </li>
            }
            <li class="page-item @(!Model.Products.HasNextPage ? "disabled" : "")">
                <a class="page-link rounded-pill px-3" asp-page="/Admin/Products/Index" asp-route-PageIndex="@(Model.Products.PageIndex + 1)" asp-route-Search="@Model.Search">
                    Sau →
                </a>
            </li>
        </ul>
    </nav>
}
