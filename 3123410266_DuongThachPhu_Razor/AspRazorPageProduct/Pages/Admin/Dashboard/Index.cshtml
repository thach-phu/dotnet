@page
@model AspRazorPageProduct.Pages.Admin.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard - TechStore Admin";
    var totalOrders = Model.Summary.StatusCounts.PendingConfirmation +
                      Model.Summary.StatusCounts.Confirmed +
                      Model.Summary.StatusCounts.Shipping +
                      Model.Summary.StatusCounts.Delivered +
                      Model.Summary.StatusCounts.Cancelled;
}

<div class="admin-panel-card mb-4">
    <div class="admin-panel-header d-flex justify-content-between align-items-center flex-wrap gap-3 pb-3 border-bottom mb-4">
        <div class="header-left">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 font-monospace fw-bold">ADMIN CONSOLE</span>
                <span class="text-success small fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Real-time System Active</span>
            </div>
            <h2 class="panel-title fs-3 fw-bold mb-1">Bảng Điều Khiển Quản Trị</h2>
            <span class="panel-sub text-muted small">Thống kê doanh thu, trạng thái đơn hàng và hiệu suất bán lẻ toàn hệ thống.</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Orders/Index" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold btn-sm">
                <i class="bi bi-receipt me-1"></i> Xem đơn hàng
            </a>
            <a asp-page="/Admin/Products/Create" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <!-- Enhanced Stats Grid -->
    <div class="dashboard-stats-grid mb-4">
        <!-- Revenue Card -->
        <div class="ts-stat-card stat-card-revenue">
            <div class="stat-card-inner">
                <div class="stat-card-header">
                    <span class="stat-label">Tổng doanh thu tích lũy</span>
                    <span class="stat-icon-badge bg-primary text-white">
                        <i class="bi bi-currency-dollar"></i>
                    </span>
                </div>
                <strong class="stat-value text-primary">@Model.Summary.TotalRevenue.ToString("N0")₫</strong>
                <div class="stat-card-footer">
                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">
                        <i class="bi bi-arrow-up-right me-1"></i>Tổng giá trị hoàn tất
                    </span>
                </div>
            </div>
        </div>

        <!-- Pending Confirmation -->
        <div class="ts-stat-card stat-card-pending">
            <div class="stat-card-inner">
                <div class="stat-card-header">
                    <span class="stat-label">Chờ xác nhận</span>
                    <span class="stat-icon-badge bg-warning text-dark">
                        <i class="bi bi-hourglass-split"></i>
                    </span>
                </div>
                <strong class="stat-value text-warning-emphasis">@Model.Summary.StatusCounts.PendingConfirmation</strong>
                <div class="stat-card-footer">
                    <span class="text-muted small">Cần CSKH duyệt ngay</span>
                </div>
            </div>
        </div>

        <!-- Confirmed -->
        <div class="ts-stat-card stat-card-confirmed">
            <div class="stat-card-inner">
                <div class="stat-card-header">
                    <span class="stat-label">Đã xác nhận</span>
                    <span class="stat-icon-badge bg-info text-white">
                        <i class="bi bi-check2-circle"></i>
                    </span>
                </div>
                <strong class="stat-value text-info-emphasis">@Model.Summary.StatusCounts.Confirmed</strong>
                <div class="stat-card-footer">
                    <span class="text-muted small">Đang đóng gói trong kho</span>
                </div>
            </div>
        </div>

        <!-- Shipping -->
        <div class="ts-stat-card stat-card-shipping">
            <div class="stat-card-inner">
                <div class="stat-card-header">
                    <span class="stat-label">Đang vận chuyển</span>
                    <span class="stat-icon-badge bg-primary-subtle text-primary">
                        <i class="bi bi-truck"></i>
                    </span>
                </div>
                <strong class="stat-value text-primary">@Model.Summary.StatusCounts.Shipping</strong>
                <div class="stat-card-footer">
                    <span class="text-muted small">Đang giao tới khách hàng</span>
                </div>
            </div>
        </div>

        <!-- Delivered -->
        <div class="ts-stat-card stat-card-delivered">
            <div class="stat-card-inner">
                <div class="stat-card-header">
                    <span class="stat-label">Đã hoàn thành</span>
                    <span class="stat-icon-badge bg-success text-white">
                        <i class="bi bi-box2-heart-fill"></i>
                    </span>
                </div>
                <strong class="stat-value text-success">@Model.Summary.StatusCounts.Delivered</strong>
                <div class="stat-card-footer">
                    <span class="text-muted small">Giao thành công &amp; thu tiền</span>
                </div>
            </div>
        </div>

        <!-- Cancelled -->
        <div class="ts-stat-card stat-card-cancelled">
            <div class="stat-card-inner">
                <div class="stat-card-header">
                    <span class="stat-label">Đã hủy đơn</span>
                    <span class="stat-icon-badge bg-danger text-white">
                        <i class="bi bi-x-octagon-fill"></i>
                    </span>
                </div>
                <strong class="stat-value text-danger">@Model.Summary.StatusCounts.Cancelled</strong>
                <div class="stat-card-footer">
                    <span class="text-muted small">Khách hủy hoặc hết hàng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts & System Health -->
    <div class="row g-4 mt-2">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm bg-white p-4 h-100">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart-fill text-primary"></i> Phân Bổ Tỷ Trọng Đơn Hàng
                </h5>
                <p class="text-muted small mb-4">Tổng số đơn hàng toàn bộ lịch sử: <strong>@totalOrders đơn hàng</strong></p>
                
                <div class="order-progress-breakdown mb-4">
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span>Tỷ lệ hoàn thành đơn</span>
                        <span class="text-success">
                            @(totalOrders > 0 ? $"{(Model.Summary.StatusCounts.Delivered * 100.0 / totalOrders):N1}%" : "0%")
                        </span>
                    </div>
                    <div class="progress rounded-pill" style="height: 10px;">
                        @{
                            var deliveredPct = totalOrders > 0 ? (Model.Summary.StatusCounts.Delivered * 100.0 / totalOrders) : 0;
                            var pendingPct = totalOrders > 0 ? (Model.Summary.StatusCounts.PendingConfirmation * 100.0 / totalOrders) : 0;
                            var shippingPct = totalOrders > 0 ? (Model.Summary.StatusCounts.Shipping * 100.0 / totalOrders) : 0;
                            var cancelledPct = totalOrders > 0 ? (Model.Summary.StatusCounts.Cancelled * 100.0 / totalOrders) : 0;
                        }
                        <div class="progress-bar bg-success" role="progressbar" style="width: @deliveredPct%;" title="Đã hoàn thành"></div>
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @pendingPct%;" title="Chờ duyệt"></div>
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @shippingPct%;" title="Đang giao"></div>
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @cancelledPct%;" title="Đã hủy"></div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-sm-3 col-6 text-center p-2 rounded-3 bg-light">
                        <small class="text-muted d-block">Hoàn thành</small>
                        <strong class="text-success fs-5">@Model.Summary.StatusCounts.Delivered</strong>
                    </div>
                    <div class="col-sm-3 col-6 text-center p-2 rounded-3 bg-light">
                        <small class="text-muted d-block">Chờ duyệt</small>
                        <strong class="text-warning-emphasis fs-5">@Model.Summary.StatusCounts.PendingConfirmation</strong>
                    </div>
                    <div class="col-sm-3 col-6 text-center p-2 rounded-3 bg-light">
                        <small class="text-muted d-block">Đang giao</small>
                        <strong class="text-primary fs-5">@Model.Summary.StatusCounts.Shipping</strong>
                    </div>
                    <div class="col-sm-3 col-6 text-center p-2 rounded-3 bg-light">
                        <small class="text-muted d-block">Đã hủy</small>
                        <strong class="text-danger fs-5">@Model.Summary.StatusCounts.Cancelled</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm bg-white p-4 h-100">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Thao Tác Nhanh
                </h5>
                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Admin/Products/Create" class="btn btn-light text-start rounded-3 p-3 d-flex align-items-center justify-content-between hover-lift">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle text-primary fs-5"></i>
                            <div>
                                <strong class="d-block text-dark small">Thêm sản phẩm mới</strong>
                                <small class="text-muted">Nhập sản phẩm vào kho</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>

                    <a asp-page="/Admin/Orders/Index" class="btn btn-light text-start rounded-3 p-3 d-flex align-items-center justify-content-between hover-lift">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-warning fs-5"></i>
                            <div>
                                <strong class="d-block text-dark small">Xử lý đơn hàng</strong>
                                <small class="text-muted">Duyệt &amp; cập nhật vận chuyển</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>

                    <a asp-page="/Admin/Categories/Index" class="btn btn-light text-start rounded-3 p-3 d-flex align-items-center justify-content-between hover-lift">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-tags text-success fs-5"></i>
                            <div>
                                <strong class="d-block text-dark small">Quản lý danh mục</strong>
                                <small class="text-muted">Thêm danh mục thiết bị</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
