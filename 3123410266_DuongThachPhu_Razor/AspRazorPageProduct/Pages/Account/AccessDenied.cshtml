@page
@{ 
    ViewData["Title"] = "Không có quyền truy cập - TechStore"; 
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white text-center">
            <div class="d-inline-grid place-items-center bg-danger-subtle text-danger rounded-circle mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <span class="badge bg-danger-subtle text-danger text-uppercase px-3 py-1 rounded-pill small fw-bold mb-2">BẢO MẬT HỆ THỐNG</span>
            <h2 class="fs-4 fw-bold mb-2">Truy Cập Bị Giới Hạn</h2>
            <p class="text-muted small mb-4">
                Tài khoản của bạn hiện tại chưa được cấp quyền truy cập vào phân hệ này. Vui lòng liên hệ với Quản trị viên để được phân quyền.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-page="/Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-house-door-fill me-1"></i> Trang chủ
                </a>
                <a asp-page="/Account/Login" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Đổi tài khoản
                </a>
            </div>
        </div>
    </div>
</div>
