@page
@model AspRazorPageProduct.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - TechStore";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="ts-brand-badge mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-1 mb-2">TÀI KHOẢN HỆ THỐNG</span>
                <h2 class="fs-4 fw-bold mt-1 mb-2">Đăng Ký Tài Khoản</h2>
                <p class="text-muted small">Tạo tài khoản thành viên để mua sắm và theo dõi đơn hàng tại TechStore.</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger rounded-3 py-2 px-3 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold text-secondary">Họ và tên</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Nguyễn Văn A" required />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label small fw-semibold text-secondary">Số điện thoại</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Phone" type="tel" class="form-control border-start-0 ps-0" placeholder="0912345678" required />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary">Địa chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="Tối thiểu 6 ký tự..." required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu..." required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="ts-btn-primary w-100 py-3 text-center justify-content-center fs-6">
                    <span>Tạo tài khoản mới</span>
                    <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <div class="text-center mt-4 text-muted small">
                Đã có tài khoản? <a asp-page="/Account/Login" class="text-primary fw-bold text-decoration-none">Đăng nhập tại đây</a>
            </div>
        </div>
    </div>
</div>
