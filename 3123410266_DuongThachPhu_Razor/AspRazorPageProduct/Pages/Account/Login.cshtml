@page
@model AspRazorPageProduct.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản - TechStore";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="ts-brand-badge mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-1 mb-2">TÀI KHOẢN HỆ THỐNG</span>
                <h2 class="fs-4 fw-bold mt-1 mb-2">Đăng Nhập TechStore</h2>
                <p class="text-muted small">Đăng nhập tài khoản để quản lý đơn hàng hoặc truy cập khu vực quản trị.</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger rounded-3 py-2 px-3 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary">Địa chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" id="emailInput" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" id="passwordInput" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu..." required />
                    </div>
                </div>

                <button type="submit" class="ts-btn-primary w-100 py-3 text-center justify-content-center fs-6">
                    <span>Đăng nhập hệ thống</span>
                    <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>
        </div>
    </div>
</div>
