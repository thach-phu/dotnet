@page "/login"

<PageTitle>Đăng nhập - Phú Store</PageTitle>

<div class="login-page-container">
    <div class="login-box-card">
        <a class="login-back-home" href="/">
            ← Quay lại trang chủ
        </a>

        <div class="login-header-section">
            <div class="login-brand-logo">
                <span class="apple-symbol"></span>
                <span class="brand-title">Phú Store</span>
            </div>
            <h1 class="login-main-title">Đăng Nhập</h1>
            <p class="login-subtext">Đăng nhập tài khoản để mua sắm và theo dõi đơn hàng tại Phú Store.</p>
        </div>

        <EditForm Model="Input" FormName="login" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="login-form-fields">
                <div class="login-field-item">
                    <label>Email</label>
                    <div class="login-input-icon-wrap">
                        <span class="field-icon">👤</span>
                        <InputText @bind-Value="Input.Email" class="login-input" />
                    </div>
                    <ValidationMessage For="@(() => Input.Email)" class="val-err" />
                </div>

                <div class="login-field-item">
                    <label>Mật khẩu</label>
                    <div class="login-input-icon-wrap">
                        <span class="field-icon">🔒</span>
                        <InputText type="password" @bind-Value="Input.Password" placeholder="Nhập mật khẩu..." class="login-input" />
                    </div>
                    <ValidationMessage For="@(() => Input.Password)" class="val-err" />
                </div>

                @if (loginErrorMessage is not null)
                {
                    <div class="login-error-alert" role="alert">
                        <span>⚠️ @loginErrorMessage</span>
                    </div>
                }

                <button type="submit" class="btn-login-submit">
                    <span>Đăng nhập</span>
                    <span>→</span>
                </button>
            </div>
        </EditForm>

        <div class="login-demo-helper">
            <p>Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    [Inject] private UserManager<User> UserManager { get; set; } = default!;
    [Inject] private IUserClaimsPrincipalFactory<User> ClaimsFactory { get; set; } = default!;

    private string? loginErrorMessage;

    protected override void OnInitialized() => Input ??= new();

    private async Task HandleLogin()
    {
        var email = Input.Email.Trim();
        var user = await UserManager.FindByEmailAsync(email);
        if (user is null || !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            loginErrorMessage = "Email hoặc mật khẩu không đúng. Vui lòng kiểm tra lại.";
            return;
        }
        if (await UserManager.IsLockedOutAsync(user))
        {
            loginErrorMessage = "Tài khoản này đã bị vô hiệu hóa.";
            return;
        }

        var principal = await ClaimsFactory.CreateAsync(user);
        if (Permissions.HasAnyAdminAccess(principal))
        {
            loginErrorMessage = "Tài khoản quản trị vui lòng đăng nhập tại trang quản trị (/admin/login).";
            return;
        }

        await HttpContext.SignInAsync(IdentityConstants.ApplicationScheme, principal);

        var redirectTo = AuthClaimsFactory.IsSafeLocalReturnUrl(ReturnUrl) ? ReturnUrl! : "/";
        HttpContext.Response.Redirect(redirectTo);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        public string Password { get; set; } = "";
    }
}
