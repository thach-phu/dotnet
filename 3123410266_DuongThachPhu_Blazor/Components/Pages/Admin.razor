    // isUserActionBusy chỉ để vô hiệu hóa nút/tránh người dùng bấm chồng trên UI;
    // an toàn thật sự với DbContext dùng chung nằm ở dbGate (xem ghi chú cạnh khai
    // báo dbGate phía trên).
    private bool isUserActionBusy;

    private async Task HandleRoleChange(int userId, ChangeEventArgs e)
    {
        if (isUserActionBusy) return;
        if (!int.TryParse(e.Value?.ToString(), out var roleId)) return;

        isUserActionBusy = true;
        await dbGate.WaitAsync();
        try
        {
            var (success, error) = await UserService.UpdateRoleAsync(userId, roleId);
            if (success)
            {
                ShowToast("Đã cập nhật vai trò người dùng.");
            }
            else
            {
                roleActionError = error;
            }
        }
        finally
        {
            dbGate.Release();
            isUserActionBusy = false;
        }
    }

    private async Task ToggleUserLockout(int userId, bool disable)
    {
        if (isUserActionBusy) return;

        isUserActionBusy = true;
        await dbGate.WaitAsync();
        try
        {
            var (success, error) = await UserService.SetUserLockoutAsync(userId, disable);
            if (success)
            {
                ShowToast(disable ? "Đã tắt tài khoản." : "Đã bật lại tài khoản.");
            }
            else
            {
                accountActionError = error;
            }
        }
        finally
        {
            dbGate.Release();
            isUserActionBusy = false;
        }
    }

    private async Task DeleteUser(int userId)
    {
        if (isUserActionBusy) return;

        isUserActionBusy = true;
        await dbGate.WaitAsync();
        try
        {
            var (success, error) = await UserService.DeleteUserAsync(userId);
            if (success)
            {
                ShowToast("Đã xóa tài khoản.");
            }
            else
            {
                accountActionError = error;
            }
        }
        finally
        {
            dbGate.Release();
            isUserActionBusy = false;
        }
    }

    private void TogglePermission(Role role, string code, bool isChecked)
    {
        var current = RoleService.GetPermissionCodes(role.Id).ToHashSet();
        if (isChecked)
        {
            current.Add(code);
        }
        else
        {
            current.Remove(code);
        }
        RoleService.SetRolePermissions(role.Id, current);
    }

    private async Task HandleCreateRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            roleActionError = "Vui lòng nhập tên vai trò.";
            return;
        }

        await dbGate.WaitAsync();
        try
        {
            var (success, error, role) = await RoleService.CreateRoleAsync(
                newRoleName.Trim(),
                string.IsNullOrWhiteSpace(newRoleDescription) ? null : newRoleDescription.Trim());

            if (!success)
            {
                roleActionError = error;
                return;
            }

            roleActionError = null;
            newRoleName = "";
            newRoleDescription = "";
            ShowToast("Đã tạo vai trò mới.");
        }
        finally
        {
            dbGate.Release();
        }
    }

    private async Task HandleDeleteRole(int roleId)
    {
        await dbGate.WaitAsync();
        try
        {
            var (success, error) = await RoleService.DeleteRoleAsync(roleId);
            roleActionError = success ? null : error;
            if (success)
            {
                ShowToast("Đã xóa vai trò.");
            }
        }
        finally
        {
            dbGate.Release();
        }
    }

