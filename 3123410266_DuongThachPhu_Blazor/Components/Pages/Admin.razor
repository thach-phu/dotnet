                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    <span class="fs-1 d-block mb-2">👥</span>
                                                    Chưa có người dùng nào trong hệ thống.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var user in AllUsers)
                                            {
                                                var isDisabled = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                                                <tr>
                                                    <td>@user.Email</td>
                                                    <td>@user.FullName</td>
                                                    <td>@user.PhoneNumber</td>
                                                    <td>
                                                        <select class="admin-cat-select" value="@UserService.GetRoleId(user.Id)" disabled="@isUserActionBusy" @onchange="(e) => HandleRoleChange(user.Id, e)">
                                                            @foreach (var role in AllRoles)
                                                            {
                                                                <option value="@role.Id">@role.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        @if (isDisabled)
                                                        {
                                                            <span class="order-status-badge status-cancelled">Đã khóa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="order-status-badge status-completed">Hoạt động</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <label class="toggle-switch" title="@(isDisabled ? "Bật tài khoản" : "Tắt tài khoản")">
                                                            <input type="checkbox" checked="@(!isDisabled)" disabled="@isUserActionBusy" @onchange="() => ToggleUserLockout(user.Id, !isDisabled)" />
                                                            <span class="toggle-slider"></span>
                                                        </label>
                                                        <button class="btn-action-del" disabled="@isUserActionBusy" @onclick="() => DeleteUser(user.Id)" title="Xóa tài khoản">
                                                            🗑 Xóa
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="admin-panel-card">
                            <div class="admin-panel-header">
                                <div class="header-left">
                                    <h2 class="panel-title">Vai Trò &amp; Phân Quyền</h2>
