                            @if (roleActionError is not null)
                            {
                                <div class="login-error-alert" role="alert">
                                    <span>⚠️ @roleActionError</span>
                                </div>
                            }

                            <div class="admin-filter-bar">
                                <input type="text" placeholder="Tên vai trò mới..." @bind="newRoleName" class="admin-search-input" />
                                <input type="text" placeholder="Mô tả (tùy chọn)..." @bind="newRoleDescription" class="admin-search-input" />
