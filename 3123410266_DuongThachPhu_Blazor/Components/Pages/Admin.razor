@code {
    private string currentTab = "dashboard";
    private string adminSearch = "";
    private string adminCatFilter = "all";
    private string orderStatusFilter = "all";

    private bool showProductModal;
    private bool isEditing;
    private ProductDraftModel draft = new();
    private Product? productToDelete;
    private string? toastMessage;
    private CancellationTokenSource? toastCts;

    // StoreDbContext dùng chung cho cả circuit Blazor Server (xem IdentityUserStore,
    // ProductCatalog...). Toast tự ẩn sau 2.5s qua Task.Run + InvokeAsync(StateHasChanged)
    // chạy nền độc lập — nếu nó render đúng lúc 1 thao tác async khác (xóa/khóa tài
    // khoản, tạo vai trò...) đang query/ghi DB thì 2 thao tác đụng cùng 1 DbContext và
    // EF Core ném "A second operation was started on this context instance...". Mọi
    // async handler có đụng DB và việc hẹn giờ ẩn toast đều phải giành chung 1 khóa này
    // trước khi chạm vào DB/trigger render để không bao giờ chạy chồng lên nhau.
    private readonly SemaphoreSlim dbGate = new(1, 1);

    private string newRoleName = "";
    private string newRoleDescription = "";
    private string? roleActionError;
    private bool showAccountModal;
    private string? accountActionError;
    private NewAccountModel newAccount = new();
    private string newCategoryName = "";
    private string? categoryActionError;
    private string? orderActionError;
    private int? editingCategoryId;
    private string editingCategoryName = "";
    private string newCustomerName = "";
    private string newCustomerPhone = "";
    private string? customerActionError;
    private int? mappingCustomerId;
    private int selectedUserIdToMap;
    private int? editingCustomerId;
    private string editingCustomerName = "";
    private string editingCustomerPhone = "";

    private List<Order> Orders => OrderService.GetOrders();
    private List<User> AllUsers => UserService.GetAllWithRoles();
    private List<Role> AllRoles => RoleService.GetRoles();
    private List<Permission> PermissionCatalog => RoleService.GetPermissionCatalog();
    private List<Category> Categories => CategoryService.GetAll();
    private List<CustomerListItem> Customers => CustomerService.GetAll();
    private List<User> UnlinkedUsers => CustomerService.GetUnlinkedUsers();

    private int PendingOrdersCount => Orders.Count(o => o.Status == "Chờ xác nhận");
    private OrderService.DashboardSummary Summary => OrderService.GetDashboardSummary();

    private IEnumerable<Product> FilteredAdminProducts
    {
        get
        {
            var query = Catalog.Products.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(adminSearch))
            {
                query = query.Where(p =>
                    p.Name.Contains(adminSearch, StringComparison.OrdinalIgnoreCase) ||
                    p.Category.Contains(adminSearch, StringComparison.OrdinalIgnoreCase));
            }

            if (adminCatFilter != "all")
            {
                query = query.Where(p => string.Equals(p.Category, adminCatFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(p => p.Id);
        }
    }

    private IEnumerable<Order> FilteredOrders
    {
        get
        {
            var query = Orders.AsEnumerable();
            if (orderStatusFilter != "all")
            {
                query = query.Where(o => o.Status == orderStatusFilter);
            }
            return query;
        }
    }

    private void OpenAddModal()
    {
        draft = new();
        isEditing = false;
        showProductModal = true;
    }

    private void OpenEditModal(Product product)
    {
        draft = new ProductDraftModel
        {
            Id = product.Id,
            Name = product.Name,
            Category = product.Category,
            Price = product.Price,
            Description = product.Description,
            Emoji = product.Emoji,
            ImageUrl = product.ImageUrl,
            IsPopular = product.IsPopular
        };
        isEditing = true;
        showProductModal = true;
    }

    private void CloseModal()
    {
        showProductModal = false;
    }

    private void SaveProduct()
    {
        if (isEditing && draft.Id.HasValue)
        {
            var product = new Product(
                draft.Id.Value,
                draft.Name,
                draft.Category,
                draft.Price,
                draft.Description,
                string.IsNullOrWhiteSpace(draft.Emoji) ? "📱" : draft.Emoji,
                draft.IsPopular,
                draft.ImageUrl ?? "");

            Catalog.Update(product);
            ShowToast($"Đã cập nhật sản phẩm: {draft.Name}");
        }
        else
        {
            var product = new Product(
                0,
                draft.Name,
                draft.Category,
                draft.Price,
                draft.Description,
                string.IsNullOrWhiteSpace(draft.Emoji) ? "📱" : draft.Emoji,
                draft.IsPopular,
                draft.ImageUrl ?? "");

            Catalog.Add(product);
            ShowToast($"Đã thêm mới sản phẩm: {draft.Name}");
        }

        showProductModal = false;
    }

    private void PromptDelete(Product product)
    {
        productToDelete = product;
    }

    private void ConfirmDeleteProduct()
    {
        if (productToDelete is not null)
        {
            var name = productToDelete.Name;
            Catalog.Remove(productToDelete.Id);
            productToDelete = null;
            ShowToast($"Đã xóa sản phẩm: {name}");
        }
    }

