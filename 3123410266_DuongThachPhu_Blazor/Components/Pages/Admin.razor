            <button class="modal-close-btn" @onclick="CloseModal">✕</button>
        </div>

        <EditForm Model="draft" OnValidSubmit="SaveProduct">
            <DataAnnotationsValidator />

            <div class="modal-body-form">
                <div class="form-row-two">
                    <div class="form-field">
                        <label>Tên sản phẩm <span class="req">*</span></label>
                        <InputText @bind-Value="draft.Name" placeholder="Ví dụ: iPhone 16 Pro Max 256GB" class="form-ctrl" />
                        <ValidationMessage For="@(() => draft.Name)" class="val-err" />
                    </div>

                    <div class="form-field">
                        <label>Dòng máy (Danh mục) <span class="req">*</span></label>
                        <InputText @bind-Value="draft.Category" placeholder="Ví dụ: iPhone 16" class="form-ctrl" />
                        <ValidationMessage For="@(() => draft.Category)" class="val-err" />
                    </div>
                </div>

                <div class="form-row-two">
                    <div class="form-field">
                        <label>Giá bán (VNĐ) <span class="req">*</span></label>
                        <InputNumber @bind-Value="draft.Price" placeholder="Ví dụ: 30990000" class="form-ctrl" />
                        <ValidationMessage For="@(() => draft.Price)" class="val-err" />
                    </div>

                    <div class="form-field">
                        <label>Biểu tượng Emoji</label>
                        <InputText @bind-Value="draft.Emoji" placeholder="📱" class="form-ctrl" />
                    </div>
                </div>

                <div class="form-field">
                    <label>URL Hình ảnh sản phẩm</label>
                    <InputText @bind-Value="draft.ImageUrl" placeholder="https://..." class="form-ctrl" />
                    @if (!string.IsNullOrWhiteSpace(draft.ImageUrl))
                    {
                        <div class="image-preview-box">
                            <span class="preview-label">Xem trước ảnh:</span>
                            <img src="@draft.ImageUrl" alt="Xem trước" class="preview-img" />
                        </div>
                    }
                </div>

                <div class="form-field">
                    <label>Mô tả tóm tắt <span class="req">*</span></label>
                    <InputTextArea @bind-Value="draft.Description" rows="3" placeholder="Mô tả các tính năng nổi bật..." class="form-ctrl" />
                    <ValidationMessage For="@(() => draft.Description)" class="val-err" />
                </div>

                <div class="form-field check-row">
                    <label class="check-container">
                        <InputCheckbox @bind-Value="draft.IsPopular" />
                        <span>Đặt làm <b>Sản phẩm nổi bật (Hot)</b> trên Trang chủ</span>
                    </label>
                </div>
            </div>

            <div class="modal-footer-row">
                <button type="button" class="btn-apple-secondary" @onclick="CloseModal">Hủy bỏ</button>
                <button type="submit" class="btn-apple-primary">
                    <span>@(isEditing ? "Lưu thay đổi" : "Thêm sản phẩm")</span>
                </button>
            </div>
        </EditForm>
    </div>
}

