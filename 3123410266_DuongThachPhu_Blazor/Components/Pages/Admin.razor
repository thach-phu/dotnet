<!-- ADD / EDIT PRODUCT MODAL -->
@if (showProductModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-dialog-card">
        <div class="modal-header-row">
            <div>
                <span class="eyebrow-accent">@(isEditing ? "CẬP NHẬT SẢN PHẨM" : "THÊM MỚI SẢN PHẨM")</span>
                <h3 class="modal-title">@(isEditing ? $"Chỉnh sửa: {draft.Name}" : "Thêm iPhone Mới Vào Cửa Hàng")</h3>
