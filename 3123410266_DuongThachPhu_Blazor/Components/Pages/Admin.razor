@page "/admin"
@layout BlazorWeb.Components.Layout.AdminLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject ProductCatalog Catalog
@inject OrderService OrderService
@inject CategoryService CategoryService
@inject CartService Cart
@inject UserService UserService
@inject RoleService RoleService
@inject CustomerService CustomerService

<PageTitle>Quản trị hệ thống - Phú Store</PageTitle>

<AuthorizeView Context="adminAuth">
    <Authorized>
        @if (!Permissions.HasAnyAdminAccess(adminAuth.User))
        {
            <!-- Authenticated but no admin permission at all -->
            <div class="admin-auth-prompt-card">
                <div class="auth-icon-badge">🔐</div>
                <span class="eyebrow-accent">BẢO MẬT HỆ THỐNG</span>
                <h2>Yêu Cầu Quyền Quản Trị</h2>
                <p>Tài khoản của bạn không có quyền truy cập khu vực quản trị.</p>
            </div>
        }

        else
        {
            <div class="admin-dashboard-layout">
                <!-- Sidebar -->
                <nav class="admin-sidebar">
                    <button class="admin-sidebar-link @(currentTab == "dashboard" ? "active" : "")" @onclick="@(() => currentTab = "dashboard")">
                        <span class="sidebar-icon">📊</span>
                        <span>Dashboard</span>
                    </button>
                    <AuthorizeView Policy="@Permissions.ProductsManage" Context="productsAuth">
                        <Authorized>
                            <button class="admin-sidebar-link @(currentTab == "products" ? "active" : "")" @onclick="@(() => currentTab = "products")">
                                <span class="sidebar-icon">📱</span>
                                <span>Quản Lý Sản Phẩm</span>
                                <span class="sidebar-count">@Catalog.Products.Count</span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@Permissions.CategoriesManage" Context="categoriesAuth">
                        <Authorized>
                            <button class="admin-sidebar-link @(currentTab == "categories" ? "active" : "")" @onclick="@(() => currentTab = "categories")">
                                <span class="sidebar-icon">🗂</span>
                                <span>Danh Mục</span>
                                <span class="sidebar-count">@Categories.Count</span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@Permissions.OrdersManage" Context="ordersAuth">
                        <Authorized>
                            <button class="admin-sidebar-link @(currentTab == "orders" ? "active" : "")" @onclick="@(() => currentTab = "orders")">
                                <span class="sidebar-icon">📦</span>
                                <span>Quản Lý Đơn Hàng</span>
                                @if (PendingOrdersCount > 0)
                                {
                                    <span class="sidebar-badge-notice">@PendingOrdersCount</span>
                                }
                                else
                                {
                                    <span class="sidebar-count">@Orders.Count</span>
                                }
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@Permissions.UsersManage" Context="usersAuth">
                        <Authorized>
                            <button class="admin-sidebar-link @(currentTab == "users-roles" ? "active" : "")" @onclick="@(() => currentTab = "users-roles")">
                                <span class="sidebar-icon">👥</span>
                                <span>Người Dùng &amp; Phân Quyền</span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Policy="@Permissions.CustomersManage" Context="customersAuth">
                        <Authorized>
                            <button class="admin-sidebar-link @(currentTab == "customers" ? "active" : "")" @onclick="@(() => currentTab = "customers")">
                                <span class="sidebar-icon">🧑‍🤝‍🧑</span>
                                <span>Khách Hàng</span>
                                <span class="sidebar-count">@Customers.Count</span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </nav>

                <!-- Content -->
                <div class="admin-content-area">

            @if (currentTab == "dashboard")
            {
                <div class="admin-panel-card mb-4">
                    <div class="admin-panel-header d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 border-bottom mb-4">
                        <div class="header-left">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 font-monospace fw-bold">APPLE RESELLER PORTAL</span>
                                <span class="text-success small fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Hệ thống trực tuyến</span>
                            </div>
                            <h2 class="panel-title fs-3 fw-bold mb-1">Tổng Quan Hoạt Động Cửa Hàng</h2>
                            <span class="panel-sub text-muted small">Doanh thu kinh doanh và số lượng đơn hàng theo trạng thái</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary rounded-pill px-3 py-2 btn-sm fw-semibold" @onclick="@(() => currentTab = "orders")">
                                <i class="bi bi-receipt me-1"></i> Xem đơn hàng (@Orders.Count)
                            </button>
                            <AuthorizeView Policy="@Permissions.ProductsManage">
                                <Authorized>
                                    <button class="btn btn-primary rounded-pill px-3 py-2 btn-sm fw-semibold" @onclick="OpenAddModal">
                                        <i class="bi bi-plus-circle me-1"></i> Thêm iPhone mới
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>

                    <div class="dashboard-stats-grid mb-4">
                        <div class="ts-stat-card stat-card-revenue">
                            <div class="stat-card-inner">
                                <div class="stat-card-header">
                                    <span class="stat-label">Tổng doanh thu bán ra</span>
                                    <span class="stat-icon-badge bg-primary text-white">💰</span>
                                </div>
                                <strong class="stat-value text-primary">@Summary.TotalRevenue.ToString("N0")₫</strong>
                                <div class="stat-card-footer">
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">
                                        ✓ Doanh thu đã thanh toán
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="ts-stat-card stat-card-pending">
                            <div class="stat-card-inner">
                                <div class="stat-card-header">
                                    <span class="stat-label">Chờ xác nhận</span>
                                    <span class="stat-icon-badge bg-warning text-dark">⏳</span>
                                </div>
                                <strong class="stat-value text-warning-emphasis">@Summary.StatusCounts.PendingConfirmation</strong>
                                <div class="stat-card-footer">
                                    <span class="text-muted small">Cần nhân viên liên hệ</span>
                                </div>
                            </div>
                        </div>

                        <div class="ts-stat-card stat-card-confirmed">
                            <div class="stat-card-inner">
                                <div class="stat-card-header">
                                    <span class="stat-label">Đã xác nhận</span>
                                    <span class="stat-icon-badge bg-info text-white">✅</span>
                                </div>
                                <strong class="stat-value text-info-emphasis">@Summary.StatusCounts.Confirmed</strong>
                                <div class="stat-card-footer">
                                    <span class="text-muted small">Đã xuất kho chuẩn bị gửi</span>
                                </div>
                            </div>
                        </div>

                        <div class="ts-stat-card stat-card-shipping">
                            <div class="stat-card-inner">
                                <div class="stat-card-header">
                                    <span class="stat-label">Đang vận chuyển</span>
                                    <span class="stat-icon-badge bg-primary-subtle text-primary">🚚</span>
                                </div>
                                <strong class="stat-value text-primary">@Summary.StatusCounts.Shipping</strong>
                                <div class="stat-card-footer">
                                    <span class="text-muted small">Shipper đang giao hàng</span>
                                </div>
                            </div>
                        </div>

                        <div class="ts-stat-card stat-card-delivered">
                            <div class="stat-card-inner">
                                <div class="stat-card-header">
                                    <span class="stat-label">Đã hoàn thành</span>
                                    <span class="stat-icon-badge bg-success text-white">🎉</span>
                                </div>
                                <strong class="stat-value text-success">@Summary.StatusCounts.Delivered</strong>
                                <div class="stat-card-footer">
                                    <span class="text-muted small">Giao hàng thành công</span>
                                </div>
                            </div>
                        </div>

                        <div class="ts-stat-card stat-card-cancelled">
                            <div class="stat-card-inner">
                                <div class="stat-card-header">
                                    <span class="stat-label">Đã hủy đơn</span>
                                    <span class="stat-icon-badge bg-danger text-white">❌</span>
                                </div>
                                <strong class="stat-value text-danger">@Summary.StatusCounts.Cancelled</strong>
                                <div class="stat-card-footer">
                                    <span class="text-muted small">Khách hủy hoặc từ chối</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Order ratio progress bar -->
                    <div class="order-progress-breakdown p-3 bg-light rounded-4 border">
                        <div class="d-flex justify-content-between small fw-semibold mb-2">
                            <span>Tỷ lệ hoàn thành đơn trên tổng số @Orders.Count đơn hàng</span>
                            <span class="text-success fw-bold">
                                @(Orders.Count > 0 ? $"{(Summary.StatusCounts.Delivered * 100.0 / Orders.Count):N1}%" : "0%")
                            </span>
                        </div>
                        <div class="progress rounded-pill" style="height: 10px;">
                            @{
                                var totalO = Orders.Count;
                                var delivPct = totalO > 0 ? (Summary.StatusCounts.Delivered * 100.0 / totalO) : 0;
                                var pendPct = totalO > 0 ? (Summary.StatusCounts.PendingConfirmation * 100.0 / totalO) : 0;
                                var shipPct = totalO > 0 ? (Summary.StatusCounts.Shipping * 100.0 / totalO) : 0;
                                var cancPct = totalO > 0 ? (Summary.StatusCounts.Cancelled * 100.0 / totalO) : 0;
                            }
                            <div class="progress-bar bg-success" role="progressbar" style="width: @delivPct%;" title="Đã hoàn thành"></div>
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @pendPct%;" title="Chờ xác nhận"></div>
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @shipPct%;" title="Đang giao"></div>
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @cancPct%;" title="Đã hủy"></div>
                        </div>
                    </div>
                </div>
            }
            else if (currentTab == "products")
            {
                <AuthorizeView Policy="@Permissions.ProductsManage">
                    <Authorized>
                        <!-- PRODUCTS MANAGEMENT TAB -->
                        <div class="admin-panel-card">
                            <div class="admin-panel-header">
                                <div class="header-left">
                                    <h2 class="panel-title">Danh Sách Sản Phẩm</h2>
                                    <span class="panel-sub">Thêm mới, sửa thông tin, giá bán và cấu hình sản phẩm</span>
                                </div>
                                <button class="btn-apple-primary compact" @onclick="OpenAddModal">
                                    <span>+ Thêm Sản Phẩm Mới</span>
                                </button>
                            </div>

                            <!-- Search and Filter in Table -->
                            <div class="admin-filter-bar">
                                <input type="text"
                                       placeholder="Tìm kiếm sản phẩm theo tên, danh mục..."
                                       @bind="adminSearch"
                                       @bind:event="oninput"
                                       class="admin-search-input" />

                                <select @bind="adminCatFilter" class="admin-cat-select">
                                    <option value="all">Tất cả danh mục</option>
                                    @foreach (var c in Catalog.Categories)
                                    {
                                        <option value="@c.Name">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <!-- Product Table -->
                            <div class="admin-table-responsive">
                                <table class="admin-data-table">
                                    <thead>
                                        <tr>
                                            <th>Ảnh</th>
                                            <th>Tên Sản Phẩm</th>
                                            <th>Danh Mục</th>
                                            <th>Giá Bán</th>
                                            <th>Nổi Bật</th>
                                            <th class="text-end">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!FilteredAdminProducts.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    <span class="fs-1 d-block mb-2">📦</span>
                                                    Chưa có sản phẩm nào phù hợp với tìm kiếm hoặc bộ lọc.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var product in FilteredAdminProducts)
                                            {
                                                <tr>
                                                    <td class="td-thumb">
                                                        <div class="admin-prod-thumb">
                                                            <img src="@product.ImageUrl" alt="" />
                                                            <span class="fallback-emoji">@product.Emoji</span>
                                                        </div>
                                                    </td>
                                                    <td class="td-name">
                                                        <strong>@product.Name</strong>
                                                        <small>ID: #@product.Id</small>
                                                    </td>
                                                    <td>
                                                        <span class="category-chip">@product.Category</span>
                                                    </td>
                                                    <td class="td-price">
                                                        <strong>@product.Price.ToString("N0")₫</strong>
                                                    </td>
                                                    <td>
                                                        @if (product.IsPopular)
                                                        {
                                                            <span class="badge-status-hot">🔥 Nổi bật</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted-sm">Bình thường</span>
                                                        }
                                                    </td>
                                                    <td class="td-actions text-end">
                                                        <button class="btn-action-edit" @onclick="() => OpenEditModal(product)" title="Chỉnh sửa">
                                                            ✏ Sửa
                                                        </button>
                                                        <button class="btn-action-del" @onclick="() => PromptDelete(product)" title="Xóa">
                                                            🗑 Xóa
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
            else if (currentTab == "categories")
            {
                <AuthorizeView Policy="@Permissions.CategoriesManage">
                    <Authorized>
                        <div class="admin-panel-card">
                            <div class="admin-panel-header">
                                <div class="header-left">
                                    <h2 class="panel-title">Quản Lý Danh Mục</h2>
                                    <span class="panel-sub">Tạo, đổi tên và xóa danh mục độc lập với sản phẩm</span>
                                </div>
                            </div>
                            @if (categoryActionError is not null)
                            {
                                <div class="login-error-alert" role="alert"><span>⚠️ @categoryActionError</span></div>
                            }
                            <div class="admin-filter-bar">
                                <input type="text" placeholder="Tên danh mục mới..." @bind="newCategoryName" class="admin-search-input" />
                                <button class="btn-apple-primary compact" @onclick="CreateCategory">+ Thêm danh mục</button>
                            </div>
                            <div class="admin-table-responsive">
                                <table class="admin-data-table">
                                    <thead><tr><th>Tên danh mục</th><th>Số sản phẩm</th><th class="text-end">Thao tác</th></tr></thead>
                                    <tbody>
                                        @if (!Categories.Any())
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center py-5 text-muted">
                                                    <span class="fs-1 d-block mb-2">🏷️</span>
                                                    Chưa có danh mục nào được tạo. Hãy nhập tên danh mục ở trên để thêm mới.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var category in Categories)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (editingCategoryId == category.Id)
                                                        {
                                                            <input class="admin-search-input" @bind="editingCategoryName" />
                                                        }
                                                        else
                                                        {
                                                            <strong>@category.Name</strong>
                                                        }
                                                    </td>
                                                    <td>@Catalog.Products.Count(product => product.CategoryId == category.Id)</td>
                                                    <td class="td-actions text-end">
                                                        @if (editingCategoryId == category.Id)
                                                        {
                                                            <button class="btn-action-edit" @onclick="SaveCategory">Lưu</button>
                                                            <button class="btn-action-del" @onclick="CancelCategoryEdit">Hủy</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn-action-edit" @onclick="() => BeginCategoryEdit(category)">✏ Sửa</button>
                                                            <button class="btn-action-del" @onclick="() => DeleteCategory(category.Id)">🗑 Xóa</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
            else if (currentTab == "orders")
            {
                <AuthorizeView Policy="@Permissions.OrdersManage">
                    <Authorized>
                        <!-- ORDERS MANAGEMENT TAB -->
                        <div class="admin-panel-card">
                            <div class="admin-panel-header">
                                <div class="header-left">
                                    <h2 class="panel-title">Danh Sách Đơn Hàng Khách Đặt</h2>
                                    <span class="panel-sub">Theo dõi thông tin người nhận, sản phẩm đã đặt và cập nhật tiến độ giao hàng</span>
                                </div>
                            </div>

                            <!-- Status Filter -->
                            <div class="order-status-filter-pills">
                                <button class="status-filter-btn @(orderStatusFilter == "all" ? "active" : "")" @onclick="@(() => orderStatusFilter = "all")">Tất cả (@Orders.Count)</button>
                                <button class="status-filter-btn @(orderStatusFilter == "Chờ xác nhận" ? "active" : "")" @onclick="@(() => orderStatusFilter = "Chờ xác nhận")">Chờ xác nhận (@Orders.Count(o => o.Status == "Chờ xác nhận"))</button>
                                <button class="status-filter-btn @(orderStatusFilter == "Đã xác nhận" ? "active" : "")" @onclick="@(() => orderStatusFilter = "Đã xác nhận")">Đã xác nhận (@Orders.Count(o => o.Status == "Đã xác nhận"))</button>
                                <button class="status-filter-btn @(orderStatusFilter == "Đang giao" ? "active" : "")" @onclick="@(() => orderStatusFilter = "Đang giao")">Đang giao (@Orders.Count(o => o.Status == "Đang giao"))</button>
                                <button class="status-filter-btn @(orderStatusFilter == "Đã giao" ? "active" : "")" @onclick="@(() => orderStatusFilter = "Đã giao")">Đã giao (@Orders.Count(o => o.Status == "Đã giao"))</button>
                                <button class="status-filter-btn @(orderStatusFilter == "Đã hủy" ? "active" : "")" @onclick="@(() => orderStatusFilter = "Đã hủy")">Đã hủy (@Orders.Count(o => o.Status == "Đã hủy"))</button>
                            </div>
                            @if (orderActionError is not null)
                            {
                                <div class="login-error-alert" role="alert">
                                    <span>⚠️ @orderActionError</span>
                                </div>
                            }

                            @if (FilteredOrders.Any())
                            {
                                <div class="admin-table-responsive">
                                    <table class="admin-data-table orders-table">
                                        <thead>
                                            <tr>
                                                <th>Mã Đơn</th>
                                                <th>Khách Hàng</th>
                                                <th>Địa Chỉ & Ghi Chú</th>
                                                <th>Chi Tiết Hàng</th>
                                                <th>Tổng Tiền</th>
                                                <th>Trạng Thái</th>
                                                <th class="text-end">Hành Động</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in FilteredOrders)
                                            {
                                                <tr>
                                                    <td>
                                                        <strong class="order-code-tag">#@order.OrderCode</strong>
                                                        <small class="order-time">@order.CreatedAt.ToString("dd/MM HH:mm")</small>
                                                    </td>
                                                    <td>
                                                        <strong>@order.CustomerName</strong>
                                                        <div><a href="tel:@order.CustomerPhone" class="phone-link">📞 @order.CustomerPhone</a></div>
                                                    </td>
                                                    <td class="td-address">
                                                        <p class="address-text">@order.CustomerAddress</p>
                                                        @if (!string.IsNullOrEmpty(order.Note))
                                                        {
                                                            <small class="order-note-text">📝 @order.Note</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="order-items-summary">
                                                            @foreach (var item in order.Items)
                                                            {
                                                                <div class="order-item-chip">
                                                                    <span>@item.Quantity x @item.ProductName</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="td-price">
                                                        <strong>@order.GrandTotal.ToString("N0")₫</strong>
                                                    </td>
                                                    <td>
                                                        <span class="order-status-badge @GetStatusCssClass(order.Status)">@order.Status</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn-action-edit" @onclick="() => OpenOrderDetail(order)" title="Xem chi tiết">
                                                            👁 Xem chi tiết
                                                        </button>
                                                        @if (OrderService.GetValidNextStatuses(order.Status).Contains("Đã hủy"))
                                                        {
                                                            <button class="btn-action-del" @onclick="() => CancelOrder(order.Id)" title="Hủy đơn hàng">
                                                                ✕ Hủy
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="empty-results-box" style="padding: 2.5rem 1rem;">
                                    <div class="empty-icon">📦</div>
                                    <h3>Chưa có đơn hàng nào</h3>
                                    <p>Khi khách hàng đặt hàng từ website, đơn sẽ hiển thị tại đây.</p>
                                </div>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
            else if (currentTab == "users-roles")
            {
                <AuthorizeView Policy="@Permissions.UsersManage">
                    <Authorized>
                        <!-- USERS & ROLES MANAGEMENT TAB -->
                        <div class="admin-panel-card">
                            <div class="admin-panel-header">
                                <div class="header-left">
                                    <h2 class="panel-title">Người Dùng</h2>
                                    <span class="panel-sub">Xem danh sách tài khoản và gán vai trò cho từng người dùng</span>
                                </div>
                                <button class="btn-apple-primary compact" @onclick="OpenAddAccountModal">
                                    <span>+ Thêm tài khoản</span>
                                </button>
                            </div>

                            @if (accountActionError is not null)
                            {
                                <div class="login-error-alert" role="alert">
                                    <span>⚠️ @accountActionError</span>
                                </div>
                            }

                            <div class="admin-table-responsive">
                                <table class="admin-data-table">
                                    <thead>
                                        <tr>
                                            <th>Email</th>
                                            <th>Họ Tên</th>
                                            <th>SĐT</th>
                                            <th>Vai Trò</th>
                                            <th>Trạng Thái</th>
                                            <th class="text-end">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!AllUsers.Any())
