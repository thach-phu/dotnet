@page "/not-found"
@layout MainLayout

<PageTitle>Không tìm thấy trang - Phú Store</PageTitle>

<div class="empty-results-box" style="margin: 5rem auto; max-width: 600px; padding: 4rem 2rem;">
    <div class="empty-icon" style="font-size: 5rem;">🔍</div>
    <span class="eyebrow-accent">LỖI 404</span>
    <h1 style="font-size: 2.2rem; font-weight: 800; margin: 0.8rem 0;">Trang Bạn Tìm Không Tồn Tại</h1>
    <p style="color: #64748b; font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
        Đường dẫn bạn vừa truy cập có thể đã bị thay đổi, xóa hoặc không còn tồn tại trên hệ thống của Phú Store.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a class="btn-apple-primary" href="/">
            <span>Về Trang Chủ</span>
            <span>→</span>
        </a>
        <a class="btn-apple-secondary" href="/products">
            <span>Xem Kho Sản Phẩm</span>
        </a>
    </div>
</div>