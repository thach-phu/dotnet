@inherits LayoutComponentBase

<div class="store-app-shell">
    <!-- Top Announcement Bar -->
    <div class="announcement-bar">
        <div class="announcement-content">
            <span>✨ <b>Phú Store</b> • Đại lý ủy quyền Apple chính hãng VN/A • Miễn phí vận chuyển toàn quốc cho mọi dòng iPhone • Hotline: 1800 6868</span>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <NavMenu />

    <!-- Page Content -->
    <main class="page-content-wrapper">
        @Body
    </main>

    <!-- Professional E-Commerce Footer -->
    <footer class="store-footer">
        <div class="footer-container">
            <div class="footer-grid">
                <div class="footer-col brand-col">
                    <div class="footer-brand">
                        <span class="brand-apple-icon"></span>
                        <span class="footer-brand-name">Phú Store</span>
                    </div>
                    <p class="footer-desc">
                        Đại lý ủy quyền chính thức của Apple tại Việt Nam. Cung cấp sản phẩm iPhone chính hãng VN/A, bảo hành 12 tháng tại các trung tâm Apple Authorised Service Provider trên toàn quốc.
                    </p>
                    <div class="footer-badges">
                        <span class="f-badge">✓ 100% Chính Hãng VN/A</span>
                        <span class="f-badge">✓ 1 Đổi 1 Trong 30 Ngày</span>
                    </div>
                </div>

                <div class="footer-col">
                    <h4 class="footer-title">Dòng iPhone</h4>
                    <ul class="footer-links">
                        <li><a href="/products">iPhone 16 Series</a></li>
                        <li><a href="/products">iPhone 15 Series</a></li>
                        <li><a href="/products">iPhone 14 Series</a></li>
                        <li><a href="/products">iPhone 13 Series</a></li>
                        <li><a href="/products">iPhone Cũ Like New</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 class="footer-title">Chính Sách & Hỗ Trợ</h4>
                    <ul class="footer-links">
                        <li><a href="/products">Chính sách bảo hành Apple</a></li>
                        <li><a href="/cart">Hướng dẫn mua hàng & Thanh toán</a></li>
                        <li><a href="/products">Chính sách giao hàng toàn quốc</a></li>
                        <li><a href="/products">Thu cũ đổi mới - Trợ giá đến 5TR</a></li>
                        <li><a href="/admin/login">Khu vực quản trị hệ thống</a></li>
                    </ul>
                </div>

                <div class="footer-col contact-col">
                    <h4 class="footer-title">Liên Hệ & Cửa Hàng</h4>
                    <ul class="footer-contact">
                        <li><strong>📞 Hotline mua hàng:</strong> 1800 6868 (8:00 - 21:30)</li>
                        <li><strong>🛠 Kỹ thuật & Bảo hành:</strong> 1800 6869 (8:00 - 21:00)</li>
                        <li><strong>📍 Showroom chính:</strong> 123 Đường Công Nghệ, Quận 1, TP. Hồ Chí Minh</li>
                        <li><strong>📧 Email:</strong> support@phustore.vn</li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2026 Phú Store - Apple Authorised Reseller. Tất cả quyền được bảo lưu.</p>
                <div class="footer-payment-icons">
                    <span>💵 COD</span>
                    <span>💳 Visa / Mastercard</span>
                    <span>🏦 Chuyển khoản</span>
                    <span>📱 Apple Pay</span>
                </div>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại trang</a>
    <span class="dismiss">🗙</span>
</div>

